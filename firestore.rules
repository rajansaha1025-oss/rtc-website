rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // STEP 1: replace REPLACE_WITH_ADMIN_EMAIL with the email you use to sign in to /admin. Without it, admin cannot save anything.
    function isAdmin() {
      return request.auth != null && request.auth.token.email in ['REPLACE_WITH_ADMIN_EMAIL'];
    }
    // Website content: anyone can read, only admin can change.
    match /rtc_content/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // Track-your-file: a customer can read ONE file only if they know its code. Only admin can list or write. Keep names to first name only.
    match /track/{code} {
      allow get: if true;
      allow list: if isAdmin();
      allow write: if isAdmin();
    }
    // Enquiries: visitors may only create a small, valid one. Only admin can read or change.
    match /inquiries/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name','phone','service','location','note','status','source','createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 500
        && request.resource.data.phone is string && request.resource.data.phone.size() > 0 && request.resource.data.phone.size() <= 500
        && request.resource.data.status == 'new';
      allow read, update, delete: if isAdmin();
    }
  }
}
